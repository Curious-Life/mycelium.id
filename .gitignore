# Node — match a real dir AND a worktree symlink (trailing slash misses symlinks)
node_modules
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.npmrc.local

# Build artifacts
dist/
build/
.svelte-kit/
.next/
.nuxt/
.output/
out/

# TypeScript
*.tsbuildinfo
.tsbuild/

# Test + coverage
coverage/
.nyc_output/

# Cloudflare / wrangler
.wrangler/
wrangler.toml.local

# Env + secrets — NEVER commit
.env
.env.*
!.env.example
*.secret
*.key
!packages/**/test/fixtures/*.key

# Python pipeline
__pycache__/
*.py[cod]
.venv/
.python-version
*.egg-info/
pipeline/cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local data (SQLite vault + KCV + OAuth/session store) — runtime, never commit
data/
# …but NOT source folders that happen to be named data/ (portal client helpers).
!portal-app/src/lib/data/
auth.db
*.db
*.db-shm
*.db-wal
kcv.json

# Claude Code per-developer state
.claude/projects/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/launch.json
# NB: .claude/memory/ is intentionally TRACKED (team-shared Claude memory) — see CLAUDE.md
# "Working across accounts" + scripts/claude-memory-sync.sh. It is hydrated into each
# account's ~/.claude/projects/<hash>/memory/ via that script (link/pull).

# Local scratch + operator-only debug scripts — never ship in the public repo
scratch/
.tmp/
*.local.md
/_*.mjs

# Tauri (Rust) build artifacts
src-tauri/target/
src-tauri/gen/

# Self-contained .app bundle staging (≈1 GB; rebuilt by scripts/build-app-bundle.sh)
build-staging/
.build-cache/
# Bundled sidecars — fetched by scripts/fetch-sidecars.sh, never committed
src-tauri/binaries/
portal-app/.gen-mount-intel/
portal-app/.gen-mount-flow/
portal-app/.gen-mount-aisettings/
portal-app/.gen-mount-voice/
portal-app/.gen-mount-onbflow/
portal-app/.gen-mount-invite/

# Harness scratch — the generate-store driver bundles into here and rmSync's it on the success
# path; a crash would otherwise leave it committable (independent review, LOW-4, 2026-07-16).
portal-app/.gen-drive-generate/

# Same for the D2 mount harness (compiles the components that RENDER the generate outcome).
portal-app/.gen-mount-generate/
portal-app/.gen-mount-illuminate/
portal-app/.gen-mount-pipeline/

# D-020 chat-error surface gate (mounts ChatFloat + drives the real secure-channel dispatch).
portal-app/.gen-mount-chat-error/
portal-app/.gen-drive-channel/
# D-028 part 2 — the MindscapeView loading-jitter measurement harness (verify:mindscape-loading).
portal-app/.gen-mount-mindscape-loading/
# D-065 / D-073 chat geometry + first-message gate (mounts ChatFloat and drives its resize grips).
portal-app/.gen-mount-chat-geometry/
portal-app/.gen-verify-chat-geometry/

# D-034 ↻1 — the REAL-BROWSER rail-scroll probe (portal-app/test/browser-mindscape-rail.mjs
# emits a self-contained page here; layout is unmeasurable in jsdom, so this is where the
# "does it actually scroll to the bottom" evidence is produced).
portal-app/.gen-browser-rail/

# Worktree symlinks (regenerable; machine-specific absolute paths — never commit)
/.build-cache
/pipeline/.venv

# stray mount-harness scratch output (accidentally committed in #378)
mo.json

# public-release hygiene
_*.mjs
/MEMORY.md
.claude/memory/
