{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mycelium",
  "version": "0.1.12",
  "identifier": "id.mycelium.app",
  "build": {
    "frontendDist": "../portal-app/build",
    "beforeDevCommand": "node scripts/ensure-portal-built.mjs",
    "beforeBuildCommand": "bash scripts/build-app-bundle.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Curious-Life/mycelium.id/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0OEE5Q0QwRTVDNzk0QjEKUldTeGxNZmwwSnlLTk12TUtzWUpmL2ZDbjhIQk43TXlsb0NyUHRuY3VYUnBZTjlPK2RmWWo4Q24K"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/frpc", "binaries/caddy"],
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Your private cognitive vault",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "../assets/dmg/dmg-background.tiff",
        "windowPosition": { "x": 460, "y": 180 },
        "windowSize": { "width": 560, "height": 400 },
        "appPosition": { "x": 150, "y": 180 },
        "applicationFolderPosition": { "x": 410, "y": 180 }
      }
    },
    "resources": {
      "../build-staging/": "app",
      "icons/Assets.car": "."
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
